# EA KIDS Studio — copy to .env and fill in only what you use. Placeholders only; never commit real keys.
NODE_ENV=development
HOST=127.0.0.1
PORT=4300
# PUBLIC_URL=https://studio.example.com
# TRUST_PROXY=true
# SECURE_COOKIES=true

# Encrypts YouTube tokens at rest. REQUIRED in production; auto-generated into data/.app_secret in development.
APP_SECRET=change-me-generate-with-openssl-rand-hex-32
# Needed only if you create the first owner account from another machine (otherwise use localhost or `npm run create-owner`).
# SETUP_TOKEN=change-me-long-random-string
SESSION_HOURS=12
MAX_UPLOAD_MB=50
DATA_DIR=data

# Tools (defaults assume they are on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ESPEAK_PATH=espeak-ng

# ---- AI script generation (optional; the offline lesson kits work with none of these) ----
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_TEXT_MODEL=gpt-4.1
# Local / self-hosted OpenAI-compatible server (e.g. Ollama): free, runs on your machine
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=your-local-model-name

# ---- Narration (optional paid voices; espeak-ng and your own recordings are free) ----
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=westeurope
# ELEVENLABS_API_KEY=your-elevenlabs-key
# GOOGLE_TTS_API_KEY=your-google-tts-key

# ---- YouTube (optional; see docs/GOOGLE_OAUTH_SETUP.md) ----
# YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your-client-secret
# YOUTUBE_REDIRECT_URI=http://localhost:4300/api/youtube/oauth/callback
