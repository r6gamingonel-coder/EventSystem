# Database
DATABASE_URL="postgresql://margeorges:margeorges_dev_pw@localhost:5432/margeorges_church?schema=public"

# Auth
# Generate a strong random string for production, e.g.: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Initial Super Admin (used only by `npm run db:seed` — change after first login)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@margeorges.church"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# Project timezone (IANA name) used for all date/time display and "today" logic
TIMEZONE="Asia/Baghdad"

# Public site URL (used for absolute links / sharing)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Media storage (optional locally)
# Leave unset for local dev — uploads are written to public/uploads.
# On Vercel, creating a Blob store (Storage tab) sets this automatically;
# once set, uploads go to Vercel Blob instead (see src/lib/media.ts).
# BLOB_READ_WRITE_TOKEN=""
